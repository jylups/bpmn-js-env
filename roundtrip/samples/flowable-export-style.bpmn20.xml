<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-written sample in the form Flowable's BpmnXMLConverter writes, for the
  cases the engine's test models don't show (see roundtrip/README.md):
  an unprefixed skipExpression on a sequence flow, unprefixed listener, field
  and in/out sub-attributes, CDATA field values, an unprefixed <variable> in a
  variable aggregation, a data object value, a signal scope, and the DI
  docker and rotation attributes.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.flowable.org/processdef">
  <signal id="approvalSignal" name="approval" flowable:scope="processInstance" />
  <process id="exportStyle" name="Export style" isExecutable="true" flowable:candidateStarterGroups="managers">
    <extensionElements>
      <flowable:executionListener event="start" class="org.example.StartListener">
        <flowable:field name="channel">
          <flowable:string><![CDATA[audit]]></flowable:string>
        </flowable:field>
      </flowable:executionListener>
      <flowable:eventListener events="TASK_CREATED" delegateExpression="${taskCreatedListener}" />
    </extensionElements>
    <dataObject id="threshold" name="threshold" itemSubjectRef="xsd:int">
      <extensionElements>
        <flowable:value>10</flowable:value>
      </extensionElements>
    </dataObject>
    <startEvent id="start" flowable:initiator="initiator" flowable:formFieldValidation="true" />
    <sequenceFlow id="toReview" sourceRef="start" targetRef="review" />
    <userTask id="review" name="Review" flowable:assignee="${initiator}" flowable:candidateGroups="reviewers"
              flowable:dueDate="P2D" flowable:skipExpression="${skipReview}">
      <extensionElements>
        <flowable:taskListener event="complete" expression="${reviewService.done(task)}" onTransaction="committed" />
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${reviewers}" flowable:elementVariable="reviewer">
        <extensionElements>
          <flowable:variableAggregation target="reviews" createOverviewVariable="true">
            <variable source="approved" target="approved" />
            <variable source="comment" target="comment" />
          </flowable:variableAggregation>
        </extensionElements>
      </multiInstanceLoopCharacteristics>
    </userTask>
    <sequenceFlow id="toCall" sourceRef="review" targetRef="callFulfilment" skipExpression="${skipFulfilment}">
      <extensionElements>
        <flowable:executionListener event="take" delegateExpression="${flowListener}" />
      </extensionElements>
    </sequenceFlow>
    <callActivity id="callFulfilment" calledElement="fulfilment" flowable:calledElementType="key"
                  flowable:inheritBusinessKey="true" flowable:fallbackToDefaultTenant="true">
      <extensionElements>
        <flowable:in source="orderId" target="orderId" />
        <flowable:out sourceExpression="${result.status}" target="fulfilmentStatus" />
      </extensionElements>
    </callActivity>
    <sequenceFlow id="toEnd" sourceRef="callFulfilment" targetRef="end" />
    <endEvent id="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_exportStyle">
    <bpmndi:BPMNPlane id="BPMNPlane_exportStyle" bpmnElement="exportStyle">
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
        <omgdc:Bounds x="100" y="163" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_review" bpmnElement="review">
        <omgdc:Bounds x="190" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_callFulfilment" bpmnElement="callFulfilment">
        <omgdc:Bounds x="360" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
        <omgdc:Bounds x="530" y="164" width="28" height="28" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_toReview" bpmnElement="toReview" flowable:sourceDockerX="15.0" flowable:sourceDockerY="15.0" flowable:targetDockerX="50.0" flowable:targetDockerY="40.0">
        <omgdi:waypoint x="130.0" y="178.0" />
        <omgdi:waypoint x="190.0" y="178.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_toCall" bpmnElement="toCall" flowable:sourceDockerX="50.0" flowable:sourceDockerY="40.0" flowable:targetDockerX="50.0" flowable:targetDockerY="40.0">
        <omgdi:waypoint x="290.0" y="178.0" />
        <omgdi:waypoint x="360.0" y="178.0" />
        <bpmndi:BPMNLabel flowable:rotation="90.0">
          <omgdc:Bounds x="300.0" y="150.0" width="50.0" height="14.0" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_toEnd" bpmnElement="toEnd" flowable:sourceDockerX="50.0" flowable:sourceDockerY="40.0" flowable:targetDockerX="14.0" flowable:targetDockerY="14.0">
        <omgdi:waypoint x="460.0" y="178.0" />
        <omgdi:waypoint x="530.0" y="178.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
